# Copy to .env and fill. Never commit .env.
# Values here are dev defaults matching docker-compose.yml.

# ---- Runtime ----
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Database ----
# Port 5433, not 5432 — leaves any native postgres install alone.
DATABASE_URL=postgresql://ralia:ralia_dev_only@localhost:5433/ralia?schema=public

# Separate database for the test suite, which truncates tables between tests.
# The name must contain "test" — global-setup refuses to run otherwise.
TEST_DATABASE_URL=postgresql://ralia:ralia_dev_only@localhost:5433/ralia_test?schema=public

# ---- Redis (BullMQ: click flush, scheduled work) ----
# Port 6380, not 6379 — avoids colliding with other local projects.
REDIS_URL=redis://localhost:6380

# ---- Auth ----
# Generate per environment: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Field encryption (bank details, identity documents) ----
# MUST be a different key from the DB credential — see handoff §7.
# Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# ---- Object storage (minio in dev, Cloudflare R2 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ralia-dev
S3_ACCESS_KEY_ID=ralia_minio
S3_SECRET_ACCESS_KEY=ralia_minio_dev_only
S3_FORCE_PATH_STYLE=true

# ---- OTP delivery ----
# console | sms | whatsapp — console logs the code in dev, never in prod.
OTP_PROVIDER=console
OTP_TTL_SECONDS=600

# Dev only. The console provider appends "<phone> <purpose> <code>" here so the
# end-to-end verification script can complete a real signup through the API.
# The provider refuses to boot in production, so this can never be written there.
DEV_OTP_LOG=.dev-otp.log

# ---- Consent ----
# Stamped onto every consent row. Bump when the terms or privacy policy change;
# existing rows keep the version the user actually agreed to.
POLICY_VERSION=2026-07-01

# ---- Email ----
# mailpit in dev; Resend in staging/prod.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Ralia <no-reply@ralia.local>"
RESEND_API_KEY=

# ---- OTP delivery ----
# Which channel(s) carry verification codes. "auto" (default) uses every channel whose
# creds are present: email when MAIL_TRANSPORT is set, WhatsApp when the WHATSAPP_* vars
# below are set; falls back to the dev console when nothing is configured. Can also be
# an explicit list, e.g. "email" or "email,whatsapp". Set "console" to force dev logging.
OTP_TRANSPORT=auto

# ---- WhatsApp OTP (optional; leave blank until the WhatsApp Business setup is done) ----
# When these three are set, "auto" adds WhatsApp as an OTP channel — no code change.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Tracking ----
# Public base for /r/:token. May be a separate host to keep the redirect
# serving while the main API is under load.
TRACKING_BASE_URL=http://localhost:3000

# Salt for hashing click IPs. Plain sha256(ip) is reversible across the small
# IPv4 space, so a per-deployment salt is what keeps click IPs unrecoverable (§7).
# Generate: openssl rand -hex 32
TRACKING_HASH_SALT=

# ---- Payments (Paystack) ----
# Self-service campaign funding. The public key lives in the client app
# (NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY); this secret verifies the charge server-side.
PAYSTACK_SECRET_KEY=
